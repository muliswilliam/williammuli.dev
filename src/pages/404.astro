---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found">
  <main class="mx-auto flex max-w-3xl flex-col items-start px-8 py-24 font-mono text-sm leading-relaxed md:px-16">
    <p class="text-xs font-bold uppercase tracking-wide text-gray-500">404</p>
    <h1 class="mt-3 text-2xl font-bold text-black md:text-3xl">Nothing lives here.</h1>
    <p class="mt-4 text-gray-700">The page may have moved, the link may be wrong, or I may have broken something while rebuilding the site.</p>
    <div class="mt-5 flex gap-4">
      <a href="/" class="text-black underline hover:no-underline">Go back home</a>
      <a href="/writing/" class="text-black underline hover:no-underline">Browse the writing</a>
    </div>
  </main>
</Layout>
