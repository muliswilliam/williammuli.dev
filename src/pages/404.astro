---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found - William Muli">
  <main class="mx-auto flex max-w-3xl flex-col items-start px-8 py-24 font-mono text-sm leading-relaxed md:px-16">
    <p class="text-xs font-bold uppercase tracking-wide text-gray-500">404</p>
    <h1 class="mt-3 text-2xl font-bold text-black md:text-3xl">Nothing here.</h1>
    <p class="mt-4 text-gray-700">That page doesn't exist, or it moved.</p>
    <a href="/" class="mt-5 inline-block text-black underline hover:no-underline">Go back home</a>
  </main>
</Layout>
