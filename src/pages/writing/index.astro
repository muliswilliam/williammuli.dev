---
export const prerender = true;

import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { formatArticleDate } from "../../lib/format-date";

const posts = (await getCollection("writing")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Writing - William Muli" description="All articles by William Muli.">
  <div class="min-h-screen bg-[#fdfff4]">
    <main class="mx-auto max-w-3xl px-8 py-12 font-mono text-sm leading-relaxed md:px-16">
      <a href="/" class="text-xs text-gray-500 underline hover:text-black">← back</a>

      <h1 class="mt-6 text-xl font-bold text-black">writing</h1>
      <p class="mt-1 text-xs text-gray-400">{posts.length} article{posts.length === 1 ? "" : "s"}</p>

      <ul class="mt-6 space-y-3">
        {posts.map((post) => (
          <ArticleCard
            href={`/writing/${post.id}/`}
            title={post.data.title}
            date={formatArticleDate(post.data.date)}
            description={post.data.description}
          />
        ))}
      </ul>
    </main>
  </div>
</Layout>
