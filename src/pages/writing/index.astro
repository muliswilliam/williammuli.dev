---
import Layout from "../../layouts/Layout.astro";
import { socialMeta, social, substackUrl } from "../../data/site";
import { getPublishedArticles } from "../../lib/writing";

const articles = await getPublishedArticles();
---

<Layout title={socialMeta.writing.title} description={socialMeta.writing.description}>
  <main class="mx-auto max-w-3xl px-8 pb-20 font-mono text-sm leading-relaxed md:px-16">
    <section class="pt-6">
      <p class="text-xs font-bold uppercase tracking-wide text-gray-500">writing</p>
      <h1 class="mt-3 text-2xl font-bold text-black md:text-3xl">Notes from building systems that have to work.</h1>
      <div class="mt-4 space-y-3 text-gray-700">
        <p>I write to understand things more clearly. Most articles start with a system I've built, a production problem I've met or a technical idea I'm trying to make practical.</p>
        <p>Topics include backend engineering, distributed systems, production AI, agent reliability, inference engineering and the occasional browser deep dive.</p>
      </div>
      <a href={social.rss} class="mt-4 inline-block text-sm text-black underline hover:no-underline">Follow via RSS</a>
    </section>

    <section class="mt-10">
      {
        articles.length > 0 ? (
          <ul class="space-y-3">
            {articles.map((article) => (
              <li>
                <a href={`/writing/${article.id}/`} class="block rounded-md border border-gray-200 p-4 transition-colors hover:bg-gray-50">
                  <h2 class="font-medium text-black">{article.data.title}</h2>
                  <p class="mt-1 text-sm text-gray-700">{article.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="rounded-md border border-dashed border-gray-300 p-4 text-sm text-gray-400">Nothing published here yet. I'm probably still arguing with the first draft.</p>
        )
      }
    </section>

    <!-- Newsletter -->
    <section class="mt-14 rounded-md border border-gray-200 bg-gray-50 p-5">
      {
        substackUrl ? (
          <>
            <h2 class="font-bold text-black">Get the next note in your inbox.</h2>
            <p class="mt-2 text-sm text-gray-700">Occasional writing on backend systems, production AI and inference engineering. No daily growth hacks. No manufactured urgency.</p>
            <a href={substackUrl} target="_blank" class="mt-3 inline-block rounded-md bg-black px-3 py-1.5 text-sm text-white hover:opacity-90">Subscribe on Substack</a>
            <a href={social.rss} class="mt-3 ml-3 inline-block text-sm text-black underline hover:no-underline">Or follow via RSS</a>
          </>
        ) : (
          <>
            <h2 class="font-bold text-black">Follow the next note.</h2>
            <p class="mt-2 text-sm text-gray-700">The newsletter is still being set up. RSS works today and contains everything I publish here.</p>
            <a href={social.rss} class="mt-3 inline-block rounded-md bg-black px-3 py-1.5 text-sm text-white hover:opacity-90">Follow via RSS</a>
          </>
        )
      }
    </section>
  </main>
</Layout>
