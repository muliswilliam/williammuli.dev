---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { social } from "../../data/site";
import { getPublishedArticles } from "../../lib/writing";

export async function getStaticPaths() {
  const articles = await getPublishedArticles();

  return articles.map((article, index) => ({
    params: { id: article.id },
    props: {
      article,
      previous: articles[index + 1] ?? null,
      next: articles[index - 1] ?? null,
    },
  }));
}

const { article, previous, next } = Astro.props;
const { Content } = await render(article);

const wordCount = article.body?.split(/\s+/g).length ?? 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

const dateFormat = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Layout title={article.data.title} description={article.data.description}>
  <main class="mx-auto max-w-3xl px-8 pb-20 font-mono text-sm leading-relaxed md:px-16">
    <a href="/writing/" class="mt-6 inline-block text-sm text-gray-500 underline hover:text-black">← Back to all writing</a>

    <article class="mt-6">
      <h1 class="text-2xl font-bold text-black md:text-3xl">{article.data.title}</h1>
      <div class="mt-2 flex flex-wrap gap-3 text-xs text-gray-500">
        <span>Published {dateFormat.format(article.data.publishDate)}</span>
        {article.data.updatedDate && <span>Updated {dateFormat.format(article.data.updatedDate)}</span>}
        <span>{readingMinutes} min read</span>
      </div>

      <div class="article-content mt-8 text-gray-800">
        <Content />
      </div>
    </article>

    <!-- End of article note -->
    <section class="mt-14 rounded-md border border-gray-200 bg-gray-50 p-5">
      <h2 class="font-bold text-black">Thanks for reading.</h2>
      <p class="mt-2 text-sm text-gray-700">I write about backend systems, production AI and what I'm learning about inference engineering. Follow along via RSS, or find me on LinkedIn and X for shorter notes.</p>
      <div class="mt-3 flex gap-4">
        <a href={social.rss} class="text-sm text-black underline hover:no-underline">Follow via RSS</a>
        <a href={social.linkedin} target="_blank" class="text-sm text-black underline hover:no-underline">LinkedIn</a>
        <a href={social.x} target="_blank" class="text-sm text-black underline hover:no-underline">X</a>
      </div>
    </section>

    {
      (previous || next) && (
        <section class="mt-10">
          <h2 class="font-bold text-black">Keep reading</h2>
          <div class="mt-3 grid gap-3 md:grid-cols-2">
            {previous && (
              <a href={`/writing/${previous.id}/`} class="block rounded-md border border-gray-200 p-3 hover:bg-gray-50">
                <p class="text-xs text-gray-500">Previous</p>
                <p class="mt-1 text-black">{previous.data.title}</p>
              </a>
            )}
            {next && (
              <a href={`/writing/${next.id}/`} class="block rounded-md border border-gray-200 p-3 hover:bg-gray-50">
                <p class="text-xs text-gray-500">Next</p>
                <p class="mt-1 text-black">{next.data.title}</p>
              </a>
            )}
          </div>
        </section>
      )
    }
  </main>
</Layout>
