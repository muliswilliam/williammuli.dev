---

<Layout
  title="William Muli - Senior Software Engineer"
  description="Portfolio | William Muli - Senior Software Engineer"
>
  <div class="relative min-h-screen overflow-hidden">
    <AsciiBackground />

    <main class="relative z-10 mx-auto mt-5 max-w-3xl p-8 md:p-16">
      <div class="font-mono text-sm leading-relaxed">
        <div class="space-y-8 pb-10">
          <!-- Header -->
          <div>
            <div class="flex w-full items-center justify-between font-normal text-black">
              <p>william muli</p>
              <span class="text-xs text-gray-500">(Nairobi, Kenya · UTC+3)</span>
            </div>

            <div class="mt-3 w-fit rounded-md border border-gray-300 px-1 py-0.5 text-[10px] text-gray-500">
              BACKEND SYSTEMS, PRODUCTION AI, ENGINEERING LEADERSHIP
            </div>
          </div>

          <!-- Today -->
          <div>
            <span class="font-bold text-black">today</span>
            <div class="mt-2.5">
              I'm a senior software engineer at{" "}
              <a
                href="https://www.deel.com/"
                target="_blank"
                class="inline-flex items-center rounded border border-neutral-200 bg-black p-1 text-sm leading-4 text-neutral-100 no-underline"
              >
                <img alt="Deel logo" width="16" height="16" class="mr-1 rounded" src="/logos-wm/deel.png" />Deel
              </a>, building payroll infrastructure and AI-powered workflows.
            </div>
            <div class="mt-2.5">
              i'm also CTO at{" "}
              <a
                href="https://radidigital.com/"
                target="_blank"
                class="inline-flex items-center rounded border border-neutral-200 bg-black p-1 text-sm leading-4 text-neutral-100 no-underline"
              >
                <img alt="Radi Digital logo" width="16" height="16" class="mr-1 rounded" src="/logos-wm/radidigital.png" />Radi Digital
              </a>, where we build AI agents and SaaS products — including{" "}
              <a href="https://strukchad.com/" target="_blank" class="text-black underline hover:no-underline">Strukchad</a> for construction teams and{" "}
              <a href="https://eprocurement.tija360.com/" target="_blank" class="text-black underline hover:no-underline">tija eProcurement</a> for procure-to-pay.
            </div>
            <div class="mt-2.5">
              i also{" "}
              <HoverInfo
                label="mentor"
                ariaLabel="View mentorship approach"
                heading="Mentorship"
                description="I've led and mentored teams of up to ten engineers — code reviews, design reviews, and giving people real ownership."
              />, lean on a few{" "}
              <HoverInfo
                label="working principles"
                ariaLabel="View engineering principles"
                heading="How I tend to work"
                description="Start with the real problem. Keep failure visible. Use complexity carefully. Stay close to the work."
              /> and still like being close to the code.
            </div>
          </div>

          <!-- Past -->
          <div>
            <p class="font-bold text-black">past</p>
            <div class="mt-2.5 space-y-1.5">
              <div class="flex flex-wrap items-center gap-1">
                <a href="https://brave.com/wallet/" target="_blank" class="inline-flex items-center gap-1 text-black underline hover:no-underline">
                  <img alt="Brave" width="16" height="16" class="rounded border border-gray-200" src="/logos-wm/brave.png" />brave,
                </a>
                <span class="text-gray-700">senior software engineer — browser, backend &amp; blockchain for Brave Wallet (10M+ users)</span>
              </div>
              <div class="flex flex-wrap items-center gap-1">
                <span class="inline-flex h-4 w-4 items-center justify-center rounded border border-gray-200 bg-gray-100 text-[9px] font-bold text-gray-500">F</span>
                <a href="#" class="text-black underline hover:no-underline">fitts inc,</a>
                <span class="text-gray-700">senior software engineer &amp; team lead — led 10 engineers, hands-on with architecture &amp; CI/CD</span>
              </div>
              <div class="flex flex-wrap items-center gap-1">
                <a href="https://humanitec.com" target="_blank" class="inline-flex items-center gap-1 text-black underline hover:no-underline">
                  <img alt="Humanitec" width="16" height="16" class="rounded border border-gray-200" src="/logos-wm/humanitec.png" />humanitec,
                </a>
                <span class="text-gray-700">senior software developer — React/Angular for enterprise developer platforms</span>
              </div>
              <div class="flex flex-wrap items-center gap-1">
                <a href="https://www.bbc.co.uk" target="_blank" class="inline-flex items-center gap-1 text-black underline hover:no-underline">
                  <img alt="BBC" width="16" height="16" class="rounded border border-gray-200" src="/logos-wm/bbc.png" />bbc,
                </a>
                <span class="text-gray-700">software engineer — interactive news apps &amp; data visualisations</span>
              </div>
            </div>
          </div>

          <!-- Personal projects -->
          <div>
            <p class="mb-2 font-bold text-black">selected work</p>
            <div id="projects-list">
              {projects.map((p) => <ProjectRow {...p} />)}
            </div>
          </div>

          <!-- Blog -->
          <div>
            <p class="mb-2 font-bold text-black">recent writing</p>
            <ul class="space-y-3">
              <li>
                <a href="https://muliswilliam.github.io/2019-08-05-how-a-browser-loads-a-page/" target="_blank" class="block rounded-md border border-gray-200 p-3 transition-colors hover:bg-gray-50">
                  <div class="flex items-center justify-between">
                    <h3 class="font-medium text-black">how a browser loads a page</h3>
                    <span class="text-xs text-gray-400">aug 2019</span>
                  </div>
                  <p class="mt-1 text-sm text-gray-700">what happens between typing a URL and the page showing up on screen</p>
                </a>
              </li>
              <li>
                <a href="https://muliswilliam.github.io/2019-07-21-flux-architecture/" target="_blank" class="block rounded-md border border-gray-200 p-3 transition-colors hover:bg-gray-50">
                  <div class="flex items-center justify-between">
                    <h3 class="font-medium text-black">understanding flux architecture</h3>
                    <span class="text-xs text-gray-400">jul 2019</span>
                  </div>
                  <p class="mt-1 text-sm text-gray-700">unidirectional data flow, and why it makes application state easier to reason about</p>
                </a>
              </li>
            </ul>
          </div>

          <!-- Links -->
          <div>
            <p class="mb-2 font-bold text-black">links</p>
            <div class="flex flex-wrap gap-4">
              <a href="https://github.com/muliswilliam" target="_blank" class="flex items-center gap-2 text-black underline hover:no-underline" set:html={`${icons.github}github`} />
              <a href="https://x.com/muliswilliam" target="_blank" class="flex items-center gap-2 text-black underline hover:no-underline" set:html={`${icons.twitter}x`} />
              <a href="https://www.linkedin.com/in/muliswilliam" target="_blank" class="flex items-center gap-2 text-black underline hover:no-underline" set:html={`${icons.linkedin}linkedin`} />
              <a href="mailto:willi.wambu@gmail.com" class="flex items-center gap-2 text-black underline hover:no-underline" set:html={`${icons.email}email`} />
            </div>
          </div>
        </div>
      </div>
    </main>

    <ChatBox />
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>(".project-toggle").forEach((btn) => {
      btn.addEventListener("click", () => {
        const row = btn.closest(".project-row");
        const panel = row?.querySelector<HTMLElement>(".project-panel");
        const chevron = btn.querySelector<HTMLElement>(".chevron");
        const isOpen = row?.classList.contains("is-open");

        if (isOpen) {
          row?.classList.remove("is-open", "mt-1", "overflow-hidden", "rounded-md", "border", "bg-gray-100/50", "px-3", "py-1");
          panel?.classList.add("hidden");
          if (chevron) chevron.style.transform = "rotate(0deg)";
        } else {
          row?.classList.add("is-open", "mt-1", "overflow-hidden", "rounded-md", "border", "bg-gray-100/50", "px-3", "py-1");
          panel?.classList.remove("hidden");
          if (chevron) chevron.style.transform = "rotate(180deg)";
        }
      });
    });

    const chatForm = document.getElementById("chat-form");
    const chatInput = document.getElementById("chat-input") as HTMLTextAreaElement | null;
    const chatSuggestions = document.querySelector<HTMLElement>(".chat-suggestions");

    chatInput?.addEventListener("focus", () => {
      chatSuggestions?.classList.remove("hidden");
      chatSuggestions?.classList.add("flex");
    });
    chatInput?.addEventListener("blur", () => {
      chatSuggestions?.classList.add("hidden");
      chatSuggestions?.classList.remove("flex");
    });

    document.querySelectorAll<HTMLButtonElement>(".chat-suggestion").forEach((btn) => {
      btn.addEventListener("mousedown", (e) => e.preventDefault());
      btn.addEventListener("click", () => {
        if (chatInput) {
          chatInput.value = btn.textContent?.trim() ?? "";
          chatInput.focus();
        }
      });
    });

    chatForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      if (chatInput) {
        chatInput.value = "";
      }
    });
  </script>
</Layout>
