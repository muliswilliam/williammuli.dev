---
import Layout from "../layouts/Layout.astro";
import WorkCard from "../components/WorkCard.astro";
import { site, socialMeta, social } from "../data/site";
import { selectedWork, experiencePreview } from "../data/work";
import { nowItems, nowUpdated } from "../data/now";
import { getPublishedArticles } from "../lib/writing";

const articles = (await getPublishedArticles()).slice(0, 3);
---

<Layout title={socialMeta.home.title} description={socialMeta.home.description}>
  <main class="mx-auto max-w-3xl px-8 pb-20 font-mono text-sm leading-relaxed md:px-16">
    <!-- Hero -->
    <section class="pt-6 pb-4">
      <p class="text-xs font-bold uppercase tracking-wide text-gray-500">{site.descriptor}</p>
      <h1 class="mt-3 text-2xl font-bold text-black md:text-3xl">I build systems people can rely on.</h1>
      <div class="mt-4 space-y-3 text-gray-700">
        <p>I'm William, a software engineer and engineering lead based in Nairobi. I work on payroll infrastructure, distributed backend systems and AI-powered workflows.</p>
        <p>I write about the parts of software that become interesting after the happy path: queues, retries, permissions, observability, latency and the trade-offs behind systems that have to work in production.</p>
      </div>
      <p class="mt-4 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-xs text-gray-600">
        Currently going deeper into agent reliability and LLM inference engineering.
      </p>
      <div class="mt-5 flex gap-4">
        <a href="/writing/" class="text-black underline hover:no-underline">Read my writing</a>
        <a href="#work" class="text-black underline hover:no-underline">See selected work</a>
      </div>
    </section>

    <!-- Today -->
    <section class="mt-14">
      <p class="font-bold text-black">today</p>
      <h2 class="mt-2 text-lg font-bold text-black">Mostly backend systems. Increasingly, production AI.</h2>
      <div class="mt-3 space-y-3 text-gray-700">
        <p>I currently work at Deel, where I help build payroll systems and AI-powered workflows. The work ranges from event-driven services and payroll processing to distributed agent workers running on Kubernetes.</p>
        <p>A lot of my time goes into the parts users rarely see: defining system boundaries, making asynchronous work observable, planning for partial failures and making sure a retry does not create a second problem.</p>
        <p>I also help other engineers think through designs, review difficult changes and make sensible trade-offs. I enjoy leading teams, but I still like being close to the code.</p>
      </div>
      <blockquote class="mt-4 border-l-2 border-gray-300 pl-4 text-sm italic text-gray-600">
        The demo is usually the easy part. The real work begins when the system needs permissions, retries, observability and a safe way to fail.
      </blockquote>
    </section>

    <!-- Selected work -->
    <section id="work" class="mt-14 scroll-mt-20">
      <p class="font-bold text-black">selected work</p>
      <h2 class="mt-2 text-lg font-bold text-black">A few systems I've helped build.</h2>
      <p class="mt-3 text-gray-700">My work has moved across payroll, AI automation, browser wallets, developer tools and civic technology. Here are a few projects that shaped how I think about engineering.</p>
      <div class="mt-5 space-y-4">
        {selectedWork.map((item) => <WorkCard {...item} />)}
      </div>
    </section>

    <!-- Recent writing -->
    <section class="mt-14">
      <p class="font-bold text-black">recent writing</p>
      <h2 class="mt-2 text-lg font-bold text-black">Notes from building systems that have to work.</h2>
      <p class="mt-3 text-gray-700">I use writing to make technical ideas clearer to myself. Expect practical notes on backend systems, production AI, inference engineering and the occasional return to browser internals.</p>
      {
        articles.length > 0 ? (
          <ul class="mt-5 space-y-3">
            {articles.map((article) => (
              <li>
                <a href={`/writing/${article.id}/`} class="block rounded-md border border-gray-200 p-3 transition-colors hover:bg-gray-50">
                  <h3 class="font-medium text-black">{article.data.title}</h3>
                  <p class="mt-1 text-sm text-gray-700">{article.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-5 rounded-md border border-dashed border-gray-300 p-4 text-sm text-gray-400">Nothing published here yet. I'm probably still arguing with the first draft.</p>
        )
      }
      <a href="/writing/" class="mt-4 inline-block text-sm text-black underline hover:no-underline">See all writing</a>
    </section>

    <!-- Experience preview -->
    <section class="mt-14">
      <p class="font-bold text-black">past</p>
      <h2 class="mt-2 text-lg font-bold text-black">More than a decade of building software.</h2>
      <p class="mt-3 text-gray-700">I started with collaboration tools and civic technology, moved through media and developer platforms, and eventually found my way into browser wallets, payroll infrastructure and production AI.</p>
      <div class="mt-5 space-y-4">
        {
          experiencePreview.map((item) => (
            <div>
              <p class="font-medium text-black">{item.company}</p>
              <p class="text-xs text-gray-500">{item.role}</p>
              <p class="mt-1 text-sm text-gray-700">{item.summary}</p>
            </div>
          ))
        }
      </div>
      <a href="/about/" class="mt-4 inline-block text-sm text-black underline hover:no-underline">Read the longer version</a>
    </section>

    <!-- Now -->
    <section id="now" class="mt-14 scroll-mt-20">
      <p class="font-bold text-black">now</p>
      <h2 class="mt-2 text-lg font-bold text-black">What I'm spending time on.</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        {
          nowItems.map((item) => (
            <div class="rounded-md border border-gray-200 p-4">
              <p class="text-xs font-bold uppercase tracking-wide text-gray-500">{item.label}</p>
              <p class="mt-1 font-medium text-black">{item.title}</p>
              <p class="mt-1 text-sm text-gray-700">{item.description}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-xs text-gray-400">{nowUpdated}</p>
    </section>

    <!-- Contact -->
    <section id="contact" class="mt-14 scroll-mt-20">
      <p class="font-bold text-black">elsewhere</p>
      <h2 class="mt-2 text-lg font-bold text-black">Let's compare notes.</h2>
      <div class="mt-3 space-y-3 text-gray-700">
        <p>If you're working on backend systems, production AI, developer tools or something with an interesting failure mode, I'd be happy to hear from you.</p>
        <p>The best way to reach me is by email. You can also find my work and shorter notes on GitHub, LinkedIn and X.</p>
      </div>
      <div class="mt-4 flex flex-wrap gap-4">
        <a href={social.email} class="text-black underline hover:no-underline">Send me an email</a>
        <a href={social.github} target="_blank" class="text-black underline hover:no-underline">GitHub</a>
        <a href={social.linkedin} target="_blank" class="text-black underline hover:no-underline">LinkedIn</a>
        <a href={social.x} target="_blank" class="text-black underline hover:no-underline">X</a>
      </div>
    </section>
  </main>
</Layout>
