const projects = [
  {
    name: "strukchad",
    tags: "Construction, SaaS, Radi Digital",
    href: "https://strukchad.com/",
    media: { type: "image" as const, src: "/projects-wm/strukchad.png", alt: "Strukchad construction management platform" },
    description:
      "A construction project management platform for contractors and real estate teams: BOQs, site teams, approvals, budgets, procurement, property, sales and collections in one system, with a web app for the office and a mobile app for the field. Built at Radi Digital, where I'm CTO.",
    links: [{ label: "live", href: "https://strukchad.com/" }],
  },
  {
    name: "tija eprocurement",
    tags: "Procurement, SaaS, Radi Digital",
    href: "https://eprocurement.tija360.com/",
    media: { type: "image" as const, src: "/projects-wm/tija-eprocurement.png", alt: "tija eProcurement platform" },
    description:
      "A procure-to-pay platform covering requisition-to-payment automation, approvals, budgets, audit trails and supplier management, with a built-in AI agent that flags duplicate POs and suggests inventory optimisations. Also built at Radi Digital.",
    links: [{ label: "live", href: "https://eprocurement.tija360.com/" }],
  },
  {
    name: "payroll at enterprise scale",
    tags: "TypeScript, Node.js, Payroll",
    href: "https://www.deel.com/",
    description:
      "Payroll systems that handle different countries, company sizes and regulatory requirements without becoming impossible to reason about. Scaled real-time processing for enterprise customers with 10,000+ employees, and automated payroll-liability workflows (taxes, social insurance, pensions), removing 90%+ of the manual work.",
    links: [{ label: "deel.com", href: "https://www.deel.com/" }],
  },
  {
    name: "ai workflows that take real actions",
    tags: "Claude Agent SDK, Kubernetes, Agents",
    href: "https://akai.run",
    description:
      "AI-powered workflows using the Claude Agent SDK and distributed Kubernetes workers. Not chat toys — they retrieve data, make decisions and trigger real actions, so permissions, traceability and recovery paths all have to be explicit.",
    links: [{ label: "akai.run", href: "https://akai.run" }],
  },
  {
    name: "brave wallet",
    tags: "TypeScript, Solana, EVM",
    href: "https://brave.com/wallet/",
    media: { type: "image" as const, src: "/projects-wm/brave-wallet.png", alt: "Brave Wallet" },
    description:
      "Worked across browser, backend and blockchain layers of Brave Wallet as it grew to 10M+ active users: Solana support, NFT experiences, fiat on-ramps and backend APIs used by millions of clients.",
    links: [{ label: "live", href: "https://brave.com/wallet/" }],
  },
  {
    name: "webhook-tester",
    tags: "Go, Webhooks, Dev tools",
    href: "https://github.com/muliswilliam/webhook-tester",
