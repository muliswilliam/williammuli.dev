                </a>
              </li>
              <li>
                <a href="#" class="block rounded-md border border-gray-200 p-3 transition-colors hover:bg-gray-50">
                  <div class="flex items-center justify-between">
                    <h3 class="font-medium text-black">20 agentic design patterns before 2026</h3>
                    <span class="text-xs text-gray-400">249d ago</span>
                  </div>
                  <p class="mt-1 text-sm text-gray-700">a comprehensive guide to ai agent architectures i've learned building agents</p>
                </a>
              </li>
            </ul>
          </div>

          <!-- Freelance -->
          <div>
            <p class="mb-2 font-bold text-black">freelance</p>
            <div class="space-y-1">
              <a href="#" class="block text-black underline hover:no-underline">snek.com - raffle</a>
              <a href="#" class="block text-black underline hover:no-underline">general agents - ronika</a>
            </div>
          </div>

          <!-- Links -->
          <div>
            <p class="mb-2 font-bold text-black">links</p>
            <div class="flex flex-wrap gap-4">
              <a href="https://github.com/suraj-xd" target="_blank" class="flex items-center gap-2 text-black underline hover:no-underline" set:html={`${icons.github}github`} />
              <a href="https://twitter.com/notsurajgaud" target="_blank" class="flex items-center gap-2 text-black underline hover:no-underline" set:html={`${icons.twitter}x/twitter`} />
              <a href="https://www.linkedin.com/in/gaudsuraj/" target="_blank" class="flex items-center gap-2 text-black underline hover:no-underline" set:html={`${icons.linkedin}linkedin`} />
              <a href="mailto:surajgaudx@gmail.com" class="flex items-center gap-2 text-black underline hover:no-underline" set:html={`${icons.email}email`} />
            </div>
          </div>
        </div>
      </div>
    </main>

    <ChatBox />
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>(".project-toggle").forEach((btn) => {
      btn.addEventListener("click", () => {
        const row = btn.closest(".project-row");
        const panel = row?.querySelector<HTMLElement>(".project-panel");
        const chevron = btn.querySelector<HTMLElement>(".chevron");
        const isOpen = row?.classList.contains("is-open");

        if (isOpen) {
          row?.classList.remove("is-open", "mt-1", "overflow-hidden", "rounded-md", "border", "bg-gray-100/50", "px-3", "py-1");
          panel?.classList.add("hidden");
          if (chevron) chevron.style.transform = "rotate(0deg)";
        } else {
          row?.classList.add("is-open", "mt-1", "overflow-hidden", "rounded-md", "border", "bg-gray-100/50", "px-3", "py-1");
          panel?.classList.remove("hidden");
          if (chevron) chevron.style.transform = "rotate(180deg)";
        }
      });
    });

    const chatForm = document.getElementById("chat-form");
    const chatInput = document.getElementById("chat-input") as HTMLTextAreaElement | null;
    const chatSuggestions = document.querySelector<HTMLElement>(".chat-suggestions");

    chatInput?.addEventListener("focus", () => {
      chatSuggestions?.classList.remove("hidden");
      chatSuggestions?.classList.add("flex");
    });
    chatInput?.addEventListener("blur", () => {
      chatSuggestions?.classList.add("hidden");
      chatSuggestions?.classList.remove("flex");
    });

    document.querySelectorAll<HTMLButtonElement>(".chat-suggestion").forEach((btn) => {
      btn.addEventListener("mousedown", (e) => e.preventDefault());
      btn.addEventListener("click", () => {
        if (chatInput) {
          chatInput.value = btn.textContent?.trim() ?? "";
          chatInput.focus();
        }
      });
    });

    chatForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      if (chatInput) {
        chatInput.value = "";
      }
    });
  </script>
</Layout>
