                <span class="block italic underline decoration-neutral-300 underline-offset-2 group-hover:hidden">fast.</span>
                <img alt="fast" width="120" height="120" class="hidden group-hover:block" src="/racing-car.webp" />
              </span>
            </div>
          </div>

          <!-- Today -->
          <div>
            <span class="font-bold text-black">today</span>
            <div class="mt-2.5">
              I'm a software engineer and Head of Engineering at{" "}
              <a
                href="https://extraordinary.com/"
                target="_blank"
                class="inline-flex items-center rounded border border-neutral-200 bg-black p-1 text-sm leading-4 text-neutral-100 no-underline"
