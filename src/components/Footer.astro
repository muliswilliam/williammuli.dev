---
import { footer, social } from "../data/site";
---

<footer class="mx-auto max-w-3xl px-8 py-10 font-mono text-xs text-gray-500 md:px-16">
  <div class="flex flex-col gap-3 border-t border-gray-200 pt-6 md:flex-row md:items-center md:justify-between">
    <p>{footer.text}</p>
    <div class="flex gap-4">
      <a href={social.github} target="_blank" class="underline hover:text-black">github</a>
      <a href={social.linkedin} target="_blank" class="underline hover:text-black">linkedin</a>
      <a href={social.x} target="_blank" class="underline hover:text-black">x</a>
      <a href={social.rss} class="underline hover:text-black">rss</a>
    </div>
  </div>
</footer>
