---
const suggestions = [
  "Can you help me with my project?",
  "Tell me about your work.",
  "What can we start with?",
  "Tell me about your experience.",
  "What programming languages do you know?",
];
---

<div class="pointer-events-none fixed -inset-[2.5px] z-50">
  <div class="pointer-events-auto absolute bottom-8 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center">
    <div
      id="chat-panel"
      class="mb-2 hidden w-[min(90vw,450px)] flex-col overflow-hidden rounded-xl border border-gray-200 bg-white/90 shadow-xl backdrop-blur-md"
    >
      <div class="flex items-center justify-between border-b border-gray-200 px-3 py-1.5">
        <span class="text-[10px] uppercase tracking-wide text-gray-400">chat</span>
        <button
          type="button"
          id="chat-close"
          aria-label="Close conversation"
          class="flex h-5 w-5 items-center justify-center rounded text-gray-400 hover:bg-gray-100 hover:text-black"
        >
          ✕
        </button>
      </div>
      <div id="chat-messages" class="max-h-[45vh] space-y-2 overflow-y-auto p-3 text-sm"></div>
    </div>
    <div class="chat-suggestions mb-2 hidden w-[min(90vw,450px)] flex-wrap justify-center gap-1.5">
      {
        suggestions.map((s) => (
          <button
            type="button"
            class="chat-suggestion rounded-md border border-gray-300 bg-white/70 px-2 py-1 text-[10px] uppercase tracking-wide text-gray-600 backdrop-blur-md transition-colors hover:border-black hover:text-black"
          >
            {s}
          </button>
        ))
      }
    </div>
    <div class="relative mx-auto w-[min(90vw,450px)] transition-transform duration-200 hover:scale-[1.02]">
      <form id="chat-form" class="relative">
        <div class="relative overflow-hidden rounded-xl border border-b-0 border-gray-300 bg-[#ffffff6b] px-4 py-2 shadow-xl backdrop-blur-md transition-all duration-200 hover:shadow-2xl md:py-3">
          <div class="flex items-end gap-3">
            <textarea
              id="chat-input"
              rows="1"
              maxlength="800"
              placeholder="Ask about me, work or send a message!"
              class="relative min-h-[20px] flex-1 resize-none overflow-hidden bg-transparent text-sm leading-5 text-black placeholder:text-sm focus:outline-none md:min-h-[40px] md:text-base"
            ></textarea>
            <span class="hidden pb-1 text-xs text-gray-400 md:inline">⌘ K</span>
            <button
              type="submit"
              id="chat-send"
              aria-label="Send prompt to AI Assistant"
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-black text-white transition-opacity disabled:opacity-40"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256">
                <path d="M223.87,114.52,38.05,29.5a15.68,15.68,0,0,0-19.53,22l30.6,61.6a4,4,0,0,0,3.24,2.19L164.5,128,52.36,140.71a4,4,0,0,0-3.24,2.19l-30.6,61.6a15.68,15.68,0,0,0,19.53,22L223.87,141.48A15.6,15.6,0,0,0,223.87,114.52Z"
                ></path>
              </svg>
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  type ChatMessage = { role: "user" | "assistant"; content: string };

  const panelEl = document.getElementById("chat-panel") as HTMLElement | null;
  const messagesEl = document.getElementById("chat-messages") as HTMLElement | null;
  const closeButton = document.getElementById("chat-close") as HTMLButtonElement | null;
  const suggestionsEl = document.querySelector<HTMLElement>(".chat-suggestions");
  const chatForm = document.getElementById("chat-form") as HTMLFormElement | null;
  const chatInput = document.getElementById("chat-input") as HTMLTextAreaElement | null;
  const sendButton = document.getElementById("chat-send") as HTMLButtonElement | null;

  const history: ChatMessage[] = [];
  let sending = false;

  function renderBubble(role: "user" | "assistant", text: string) {
    const bubble = document.createElement("div");
    bubble.className =
      role === "user"
        ? "ml-auto max-w-[85%] rounded-lg bg-black px-3 py-1.5 text-right text-white"
        : "mr-auto max-w-[85%] rounded-lg bg-gray-100 px-3 py-1.5 text-gray-800";
    bubble.textContent = text;
    messagesEl?.appendChild(bubble);
    if (messagesEl) messagesEl.scrollTop = messagesEl.scrollHeight;
    return bubble;
  }

  function openPanel() {
    panelEl?.classList.remove("hidden");
    panelEl?.classList.add("flex");
  }

  function closePanel() {
    panelEl?.classList.add("hidden");
    panelEl?.classList.remove("flex");
    suggestionsEl?.classList.add("hidden");
    suggestionsEl?.classList.remove("flex");
  }

  function showSuggestions() {
    suggestionsEl?.classList.remove("hidden");
    suggestionsEl?.classList.add("flex");
  }

  function hideSuggestions() {
    suggestionsEl?.classList.add("hidden");
    suggestionsEl?.classList.remove("flex");
  }

  async function sendMessage(text: string) {
    if (sending || !text.trim()) return;
    sending = true;
    if (sendButton) sendButton.disabled = true;

    openPanel();
    hideSuggestions();
    renderBubble("user", text);
    history.push({ role: "user", content: text });

    const assistantBubble = renderBubble("assistant", "…");
    let received = "";

    try {
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history }),
      });

      if (!res.ok || !res.body) {
        assistantBubble.textContent = await res.text().catch(() => "Something went wrong. Try emailing me instead.");
      } else {
        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        assistantBubble.textContent = "";

        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          received += decoder.decode(value, { stream: true });
          assistantBubble.textContent = received;
          if (messagesEl) messagesEl.scrollTop = messagesEl.scrollHeight;
        }
      }
    } catch {
      assistantBubble.textContent = "Couldn't reach the assistant right now — email willi.wambu@gmail.com instead.";
    }

    history.push({ role: "assistant", content: received || assistantBubble.textContent || "" });
    sending = false;
    if (sendButton) sendButton.disabled = false;
    showSuggestions();
    chatInput?.focus();
  }

  closeButton?.addEventListener("click", () => {
    closePanel();
    chatInput?.blur();
  });

  chatInput?.addEventListener("focus", () => {
    showSuggestions();
  });
  chatInput?.addEventListener("blur", () => {
    hideSuggestions();
  });

  document.querySelectorAll<HTMLButtonElement>(".chat-suggestion").forEach((btn) => {
    btn.addEventListener("mousedown", (e) => e.preventDefault());
    btn.addEventListener("click", () => {
      const text = btn.textContent?.trim() ?? "";
      if (chatInput) chatInput.value = "";
      sendMessage(text);
    });
  });

  chatForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    const text = chatInput?.value ?? "";
    if (chatInput) chatInput.value = "";
    sendMessage(text);
  });

  chatInput?.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      chatForm?.requestSubmit();
    }
  });
</script>
