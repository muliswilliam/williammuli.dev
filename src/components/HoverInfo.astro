---
interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  label: string;
  ariaLabel: string;
  heading: string;
  description: string;
  items?: LinkItem[];
  flags?: { emoji: string; label: string }[];
}

const { label, ariaLabel, heading, description, items, flags } = Astro.props;
---

<span class="group/hover relative inline-block cursor-pointer" role="button" aria-label={ariaLabel} tabindex="0">
  <span
    class="cursor-pointer text-sm font-medium text-nowrap underline decoration-neutral-300 decoration-wavy underline-offset-2 transition-colors hover:font-semibold hover:decoration-neutral-400"
  >
    {label}
  </span>
  <div
    role="tooltip"
    class="pointer-events-none absolute bottom-full left-1/2 z-30 mb-2 w-64 -translate-x-1/2 rounded-md border border-gray-200 bg-white p-3 text-left text-xs leading-relaxed text-gray-700 opacity-0 shadow-xl transition-opacity duration-150 group-hover/hover:pointer-events-auto group-hover/hover:opacity-100"
  >
    <p class="mb-1 font-bold text-black">{heading}</p>
    <p class="mb-2">{description}</p>
    {
      flags && (
        <ul class="flex flex-wrap gap-2">
          {flags.map((f) => (
            <li class="rounded-md border border-gray-200 px-1.5 py-0.5">
              {f.emoji} {f.label}
            </li>
          ))}
        </ul>
      )
    }
    {
      items && (
        <ul class="flex flex-wrap gap-2">
          {items.map((it) => (
            <li>
              <a href={it.href} target="_blank" rel="noopener noreferrer" class="underline hover:text-black">
                {it.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</span>
