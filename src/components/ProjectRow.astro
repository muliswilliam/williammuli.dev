---
interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  name: string;
  tags: string;
  href: string;
  media: { type: "image" | "video"; src: string; alt?: string };
  description: string;
  links: LinkItem[];
}

const { name, tags, href, media, description, links } = Astro.props;

const linkIcon =
  '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"></path></svg>';
---

<div class="project-row border-b border-gray-200">
  <button
    type="button"
    class="project-toggle flex w-full cursor-pointer items-center justify-between py-1 transition-colors"
  >
    <div class="flex items-center gap-2">
      <span class="font-medium text-black">{name}</span>
    </div>
    <div class="flex items-center gap-2">
      <div class="w-fit rounded-md border border-gray-300 px-1 py-0.5 text-[10px] text-gray-500">{tags}</div>
      <div class="chevron transition-transform duration-200">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256">
          <path
            d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"
          ></path>
        </svg>
      </div>
    </div>
  </button>
  <div class="project-panel hidden px-0 py-2">
    <div class="flex flex-col gap-4 md:flex-row">
      <a href={href} target="_blank" rel="noopener noreferrer" class="w-full flex-shrink-0 rounded-md border border-gray-200 md:max-w-[300px]">
        {
          media.type === "video" ? (
            <video src={media.src} autoplay loop playsinline muted class="h-fit max-h-[300px] w-full rounded-md object-contain" />
          ) : (
            <img src={media.src} alt={media.alt ?? name} width="300" height="200" class="h-full w-full rounded-md object-contain" />
          )
        }
      </a>
      <div class="flex-1">
        <p class="mb-3 text-sm text-gray-700">{description}</p>
        <div class="flex flex-wrap">
          {
            links.map((l) => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs hover:underline"
                set:html={`${linkIcon}${l.label}`}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>
