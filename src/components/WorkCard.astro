---
interface Props {
  type: string;
  title: string;
  description: string[];
  tags: string[];
  link?: { label: string; href: string };
}

const { type, title, description, tags, link } = Astro.props;
---

<article class="rounded-md border border-gray-200 p-5">
  <p class="text-xs text-gray-500">{type}</p>
  <h3 class="mt-1 font-bold text-black">{title}</h3>
  <div class="mt-2 space-y-2 text-sm text-gray-700">
    {description.map((p) => <p>{p}</p>)}
  </div>
  <div class="mt-3 flex flex-wrap gap-1.5">
    {tags.map((tag) => <span class="rounded-md border border-gray-300 px-1 py-0.5 text-[10px] text-gray-500">{tag}</span>)}
  </div>
  {
    link && (
      <a href={link.href} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block text-sm text-black underline hover:no-underline">
        {link.label} ↗
      </a>
    )
  }
</article>
